
# Secret key can be generated by running either commands:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# openssl rand -base64 32
SECRET_KEY=some_random_key

# Optional if you don't want AI summarization.
OPENAI_API_KEY=your_openai_api_key

# Change the `DEPLOYMENT_URL` to `hostname.yourdomain.tld` if you deploy with your domain.
# Do not include `http://` or `https://`
DEPLOYMENT_URL=hostname.yourdomain.tld

INTERNAL_PORT=8000 # Gunicorn will run on INTERNAL_PORT inside the container

# Uncomment the following section to use a custom OpenAI-compatible API, such as OneAPI or xAI.
# If you're using only the official OpenAI API, leave this section unchanged.
# If you're unsure, you can always configure a custom model later in the app.

#OPENAI_BASE_URL='https://api.openai.com/v1'

# Model list and token limits are fetched automatically:
# the model dropdowns are populated from the endpoint's /models API (cached 1h),
# and per-model input token limits come from the endpoint's metadata or from
# litellm's public model database (cached 24h). Optional overrides:

# Input token budget for models whose limits cannot be resolved from any source.
#DEFAULT_MAX_INPUT_TOKENS=126500

# Alternative source for model token limits (litellm-format JSON), e.g. a mirror.
#MODEL_METADATA_URL='https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json'

# Cache durations in seconds for the model list and the token limit metadata.
#OPENAI_MODEL_LIST_CACHE_SECONDS=3600
#MODEL_METADATA_CACHE_SECONDS=86400
